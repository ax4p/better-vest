{
  "manifest_version": 3,
  "name": "Better Vest by Astral Lite",
  "short_name": "Better Vest",
  "version": "9.0.7",
  "description": "Trading tools for Vest Markets, Lite (no voice): one-click orders with stop and target, a copy trader, limits and a P&L journal.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Vest by Astral",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabGroups"
  ],
  "host_permissions": [
    "https://next.vestmarkets.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://next.vestmarkets.com/*"
      ],
      "js": [
        "page/better-vest.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://next.vestmarkets.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cert/pop.html"
      ],
      "matches": [
        "https://next.vestmarkets.com/*"
      ]
    }
  ]
}
