{
  "manifest_version": 3,
  "name": "Better Vest by Astral",
  "short_name": "Better Vest",
  "version": "7.5.1",
  "description": "Astral suite for Vest Markets: Execute card with account presets, hotkey macros, chart TP/SL with breakeven, themes, chart styling, focus mode, calendar.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Vest by Astral",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://next.vestmarkets.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://next.vestmarkets.com/*"
      ],
      "js": [
        "page/better-vest.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://next.vestmarkets.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
